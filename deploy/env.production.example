# Production settings for the VPS. On the server:
#   cp deploy/env.production.example .env.production && chmod 600 .env.production
# then fill in every value. .env.production is git-ignored; never commit it.

# --- Site ---
DOMAIN=lucid.example.com
LETSENCRYPT_EMAIL=you@example.com

# --- Django ---
# python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=lucid.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://lucid.example.com
# Hard-to-guess path for Django Admin (superuser maintenance only), ending with /
# python3 -c "import secrets; print('ops-' + secrets.token_hex(6) + '/')"
DJANGO_ADMIN_URL=
DJANGO_LOG_LEVEL=INFO
# Start with a short HSTS time (one day) and raise it to a year once HTTPS is confirmed.
DJANGO_HSTS_SECONDS=86400

# --- PostgreSQL (container "db") ---
POSTGRES_DB=lucid
POSTGRES_USER=lucid
# python3 -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=

# --- Email (Hostinger SMTP) ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
EMAIL_HOST_USER=no-reply@lucid.example.com
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Lucid Society <no-reply@lucid.example.com>

# --- Payments ---
PAYMENT_BANK_NAME=
PAYMENT_BANK_ACCOUNT_NUMBER=
PAYMENT_BANK_ACCOUNT_NAME=
PROMPTPAY_ID=
# Days to keep slip images of finished payments (PDPA). Records stay.
SLIP_RETENTION_DAYS=365

# --- EasySlip v2 ---
EASYSLIP_API_KEY=
# live (with a key) or off (every slip goes to manager review). "fake" is refused.
EASYSLIP_MODE=live

# --- Telegram (staff alerts and server error alerts) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Backups ---
BACKUP_KEEP_DAYS=14
