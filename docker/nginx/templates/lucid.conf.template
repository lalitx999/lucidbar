# Rendered by the nginx image at start-up (envsubst replaces ${DOMAIN}).
# TLS, static files and the public treasure pictures are served here; every
# other request goes to Gunicorn. Slip images are never mounted into Nginx.

limit_req_zone $binary_remote_addr zone=lucid_auth:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=lucid_general:10m rate=20r/s;
limit_req_status 429;

upstream lucid_web {
    server web:8000;
    keepalive 16;
}

server {
    listen 80;
    listen [::]:80;
    server_name ${DOMAIN};
    server_tokens off;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${DOMAIN};
    server_tokens off;

    ssl_certificate /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:LucidSSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # Slips are re-encoded below 4 MB; leave room for the multipart overhead.
    client_max_body_size 10m;

    gzip on;
    gzip_vary on;
    gzip_types text/css application/javascript application/json application/manifest+json image/svg+xml;

    # Hashed static files (ManifestStaticFilesStorage) never change: cache for a year.
    location ~* "^/static/(?<hashed>.+\.[0-9a-f]{12}\.[a-z0-9]+)$" {
        alias /srv/static/$hashed;
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Content-Type-Options nosniff;
        access_log off;
    }

    location /static/ {
        alias /srv/static/;
        expires 1h;
        add_header X-Content-Type-Options nosniff;
        access_log off;
    }

    # Public treasure pictures only (slips live in a private volume Nginx cannot see).
    location /media/treasures/ {
        alias /srv/media/treasures/;
        expires 7d;
        add_header X-Content-Type-Options nosniff;
    }

    location /media/ {
        return 404;
    }

    # Sign-in, sign-up and code entry: slow down guessing at the edge too.
    location ~ ^/(login|join|verify|forgot)/ {
        limit_req zone=lucid_auth burst=10 nodelay;
        include /etc/nginx/templates/proxy_params.inc;
    }

    location / {
        limit_req zone=lucid_general burst=40 nodelay;
        include /etc/nginx/templates/proxy_params.inc;
    }
}
