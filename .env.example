# Copy to .env and fill in real values. Never commit .env.

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.local
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Production only, e.g. https://lucid.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=
# Use a hard-to-guess path in production, ending with a slash
DJANGO_ADMIN_URL=admin/

# --- PostgreSQL ---
POSTGRES_DB=lucid
POSTGRES_USER=lucid
POSTGRES_PASSWORD=change-me
# Inside Docker the host is "db"; for a local Postgres use localhost
DATABASE_URL=postgres://lucid:change-me@localhost:5432/lucid

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1

# --- Email (Hostinger SMTP) ---
# Leave EMAIL_BACKEND empty in local dev to print emails to the console.
EMAIL_BACKEND=
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Lucid Society <no-reply@example.com>

# --- Payments ---
PAYMENT_BANK_NAME=UOB
PAYMENT_BANK_ACCOUNT_NUMBER=
PAYMENT_BANK_ACCOUNT_NAME=
# Optional: mobile number or 13-digit tax ID for an exact-amount PromptPay QR
PROMPTPAY_ID=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- EasySlip v2 ---
EASYSLIP_API_KEY=
# live | off (staff review only) | fake (local dev only, auto-approve)
EASYSLIP_MODE=
